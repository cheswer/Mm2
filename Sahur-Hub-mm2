local DB, DBRarities = nil, { "All" }
local function LoadDB()
    if DB then return DB end
    DB = {}
    local seen = {}
    for line in DB_RAW:gmatch("[^\n]+") do
        local name, rarity, typ, id, chroma = line:match("^(.-)|(.-)|(.-)|(.-)|(.-)$")
        if name and name ~= "" then
            DB[#DB + 1] = { name = name, rarity = rarity, type = typ, id = id, chroma = chroma == "1" }
            if rarity ~= "" and not seen[rarity] then
                seen[rarity] = true
                DBRarities[#DBRarities + 1] = rarity
            end
        end
    end
    return DB
end
LoadDB()

