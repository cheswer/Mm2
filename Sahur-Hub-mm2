-- LOAD WINDUI (con pcall, varias fuentes y stubs para ejecutores moviles)
----------------------------------------------------
local WindUI, Window = (function()
    local env = genv

    local permanent = {
        isfolder  = function() return false end,
        makefolder = function() end,
        cloneref  = function(o) return o end,
        gethui    = function() return game:GetService("CoreGui") end,
    }
    local temporary = {
        isfile    = function() return false end,
        readfile  = function() return "" end,
        writefile = function() end,
        listfiles = function() return {} end,
        delfile   = function() end,
        delfolder = function() end,
    }
    local addedTemp = {}
    for name, fn in pairs(permanent) do
        if type(env[name]) ~= "function" then pcall(function() env[name] = fn end) end
    end
    for name, fn in pairs(temporary) do
        if type(env[name]) ~= "function" then
            local ok = pcall(function() env[name] = fn end)
            if ok then addedTemp[#addedTemp + 1] = name end
        end
    end

    local function notify(msg)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Sahur Hub", Text = msg, Duration = 8 })
        end)
    end

    local sources = {
        "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
        "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
        "https://github.com/Footagesus/WindUI/releases/download/1.6.41/main.lua",
    }

    local function withTimeout(seconds, fn)
        local done, result = false, nil
        task.spawn(function()
            local ok, r = pcall(fn)
            if ok then result = r end
            done = true
        end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < seconds do task.wait(0.1) end
        if not done then warn("[SAHUR] Timeout esperando WindUI") end
        return result
    end

    local function tryLoadRaw(url)
        local okGet, src = pcall(function() return game:HttpGet(url) end)
        if not okGet or type(src) ~= "string" or #src < 1000 then
            warn("[SAHUR] HttpGet fallo: " .. url .. " -> " .. tostring(src))
            return nil
        end
        local fn, cerr = loadstring(src)
        if type(fn) ~= "function" then
            warn("[SAHUR] loadstring fallo: " .. url .. " -> " .. tostring(cerr))
            return nil
        end
        local okRun, lib = pcall(fn)
        if not okRun or type(lib) ~= "table" or type(lib.CreateWindow) ~= "function" then
            warn("[SAHUR] WindUI invalido: " .. url .. " -> " .. tostring(lib))
            return nil
        end
        return lib
    end

    local function makeWindow(lib, icon, full)
        local cfg = {
            Title = "Sahur Hub",
            Icon = icon,
            Author = "Murder Mystery 2",
            Folder = "SahurHub_Configs",
            Size = UDim2.fromOffset(580, 460),
            Theme = "Dark",
        }
        if full then
            cfg.Transparent = true
            cfg.SideBarWidth = 170
            cfg.HasOutline = true
        end
        return pcall(function() return lib:CreateWindow(cfg) end)
    end

    local lib, win
    pcall(function()
        if isfile and readfile and isfile("SahurHub_UILib.txt") then
            local idx = ({ latest = 1, dist = 2, stable = 3 })[readfile("SahurHub_UILib.txt"):gsub("%s+", "")]
            if idx and idx > 1 and sources[idx] then table.insert(sources, 1, table.remove(sources, idx)) end
        end
    end)
    for _, url in ipairs(sources) do
        local candidate = withTimeout(25, function() return tryLoadRaw(url) end)
        if candidate then
            local ok, w = makeWindow(candidate, IconAsset, true)
            if not ok then
                warn("[SAHUR] CreateWindow fallo (config completa): " .. tostring(w))
                ok, w = makeWindow(candidate, FALLBACK_ICON, true)
            end
            if not ok then
                warn("[SAHUR] CreateWindow fallo (icono fallback): " .. tostring(w))
                ok, w = makeWindow(candidate, FALLBACK_ICON, false)
            end
            if ok and w then
                lib, win = candidate, w
                break
            end
            warn("[SAHUR] CreateWindow fallo (config minima): " .. tostring(w))
        end
    end

    for _, name in ipairs(addedTemp) do
        pcall(function() env[name] = nil end)
    end

    if not lib or not win then
        warn("[SAHUR] No se pudo cargar WindUI desde ninguna fuente")
        notify(Msg("Could not load the UI. Check your internet/executor and try again.",
            "No se pudo cargar la UI. Revisa tu internet/ejecutor y reintenta.",
            "Не удалось загрузить UI. Проверьте интернет/экзекутор и повторите."))
        return nil, nil
    end
    return lib, win
end)()

