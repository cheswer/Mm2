local RARITIES = { "Common", "Uncommon", "Rare", "Legendary", "Godly", "Ancient", "Unique", "Classic", "Christmas", "Halloween" }
local IdxType, IdxRarity = "Knife", "Godly"
local IdxMap = {}
local idxDD, idxInfo

local function setIdxInfo(title, desc)
    local dict = LANG ~= "en" and I18N[LANG]
    if dict and dict[title] then title = dict[title] end
    pcall(function() idxInfo:SetTitle(title) end)
    pcall(function() idxInfo:SetDesc(desc) end)
end

local function refreshIndex()
    IdxMap = {}
    local entries = {}
    if WeaponDB then
        for key, w in pairs(WeaponDB) do
            if type(w) == "table" and w.ItemType == IdxType and w.Rarity == IdxRarity then
                local label = tostring(w.ItemName or w.Name or key) .. (w.Chroma and " (Chroma)" or "") .. " [" .. tostring(key) .. "]"
                entries[#entries + 1] = label
                IdxMap[label] = key
            end
        end
    end
    table.sort(entries)
    local count = #entries
    if count == 0 then entries = { "-" } end
    if not pcall(function() idxDD:Refresh(entries) end) then pcall(function() idxDD:SetValues(entries) end) end
    setIdxInfo("Weapon Index", string.format(
        Msg("%d weapons in this category.", "%d armas en esta categoría.", "Оружия в этой категории: %d."), count))
end

local function showWeapon(label)
    local key = IdxMap[label]
    local w = key and WeaponDB and WeaponDB[key]
    if type(w) ~= "table" then return end
    local lines = {
        Msg("Name: ", "Nombre: ", "Название: ") .. tostring(w.ItemName or key),
        Msg("Type: ", "Tipo: ", "Тип: ") .. tostring(w.ItemType),
        Msg("Rarity: ", "Rareza: ", "Редкость: ") .. tostring(w.Rarity) .. (w.Chroma and " (Chroma)" or ""),
    }
    if w.Event then lines[#lines + 1] = Msg("Event: ", "Evento: ", "Событие: ") .. tostring(w.Event) .. " " .. tostring(w.Year or "") end
    if w.Season then lines[#lines + 1] = Msg("Season: ", "Temporada: ", "Сезон: ") .. tostring(w.Season) end
    if w.ItemID then lines[#lines + 1] = "ID: " .. tostring(w.ItemID) end
    lines[#lines + 1] = "Key: " .. tostring(key)
    setIdxInfo(tostring(w.ItemName or key), table.concat(lines, "\n"))
end

