local containerCache, containerAt = nil, 0
local function getContainer()
    if containerCache and containerCache.Parent then return containerCache end
    containerCache = nil
    if os.clock() - containerAt < 1.2 then return nil end
    containerAt = os.clock()
    containerCache = workspace:FindFirstChild("CoinContainer", true)
    return containerCache
end
local function listCoins()
    local cont = getContainer()
    local out = {}
    if cont then
        for _, c in ipairs(cont:GetChildren()) do
            if c.Name == "Coin_Server" then
                local p = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart")
                if p then out[#out + 1] = p end
            end
        end
    end
    return out
end

local coinAdorns = {}
local function clearCoinESP()
    for p, a in pairs(coinAdorns) do
        pcall(function() a:Destroy() end)
        coinAdorns[p] = nil
    end
end
local function updateCoinESP()
    if not Ex.ESP_Coins then
        if next(coinAdorns) then clearCoinESP() end
        return
    end
    local seen = {}
    for i, p in ipairs(listCoins()) do
        if i > 80 then break end
        seen[p] = true
        local a = coinAdorns[p]
        if not a or not a.Parent then
            a = mk("BoxHandleAdornment", { Adornee = p, AlwaysOnTop = true, ZIndex = 5, Size = Vector3.new(1.6, 1.6, 1.6), Transparency = 0.35 }, ESPFolder)
            coinAdorns[p] = a
        end
        a.Color3 = kindColor("Coin", i)
    end
    for p, a in pairs(coinAdorns) do
        if not seen[p] or not p.Parent then
            pcall(function() a:Destroy() end)
            coinAdorns[p] = nil
        end
    end
end

