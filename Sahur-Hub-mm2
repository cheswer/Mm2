-- Equipar / guardar arma (misma logica del boton del juego)
local function IsWeaponTool(t)
    return t:IsA("Tool") and (t:HasTag("Weapon_Knife") or t:HasTag("Weapon_Gun"))
end

local function HoldingWeapon()
    local char = LocalPlayer.Character
    if not char then return false end
    for _, t in ipairs(char:GetChildren()) do
        if IsWeaponTool(t) then return true end
    end
    return false
end

local function EquipToggle()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if IsWeaponTool(t) then hum:EquipTool(t) return end
        end
    end
    if HoldingWeapon() then hum:UnequipTools() end
end

