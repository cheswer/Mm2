-- Helpers de UI (mismas firmas que en el resto de hubs: tab, id, titulo, desc, default, callback)
----------------------------------------------------
local function AddToggle(tab, id, title, desc, default, cb)
    KeyTab[id] = tab
    Ex[id] = default
    local el = tab:Toggle({ Title = title, Desc = desc, Value = default, Callback = function(v)
        Ex[id] = v
        if cb then cb(v) end
    end })
    Setters[id] = function(v) Ex[id] = v pcall(function() el:Set(v) end) end
end

local function AddSlider(tab, id, title, desc, min, max, default, cb)
    KeyTab[id] = tab
    Ex[id] = default
    local el = tab:Slider({
        Title = title, Desc = desc, Step = 1,
        Value = { Min = min, Max = max, Default = default },
        Callback = function(v)
            Ex[id] = v
            if cb then cb(v) end
        end,
    })
    Setters[id] = function(v) Ex[id] = v pcall(function() el:Set(v) end) end
end

local function AddDropdown(tab, id, title, desc, values, default, cb)
    KeyTab[id] = tab
    Ex[id] = default
    local el = tab:Dropdown({ Title = title, Desc = desc, Values = values, Value = default, Callback = function(v)
        Ex[id] = v
        if cb then cb(v) end
    end })
    Setters[id] = function(v) Ex[id] = v pcall(function() el:Select(v) end) end
end

local function AddInput(tab, id, title, desc, placeholder, value, cb)
    KeyTab[id] = tab
    Ex[id] = value or ""
    local el = tab:Input({ Title = title, Desc = desc, Placeholder = placeholder, Value = value or "", Callback = function(t)
        Ex[id] = tostring(t or "")
        if cb then cb(Ex[id]) end
    end })
    Setters[id] = function(v) Ex[id] = v pcall(function() el:Set(v) end) end
end

local function AddColor(tab, id, title, desc, default, cb)
    KeyTab[id] = tab
    Ex[id] = default
    local el
    local ok = pcall(function()
        el = tab:Colorpicker({ Title = title, Desc = desc, Default = default, Callback = function(c)
            Ex[id] = c
            if cb then cb(c) end
        end })
    end)
    if ok and el then
        Setters[id] = function(v) Ex[id] = v pcall(function() el:Set(v) end) end
    end
end

local KEY_CHOICES = { "RightShift", "RightControl", "Insert", "Home", "X", "N", "G", "B", "Z", "V", "H", "J", "K", "L", "R", "T", "Y", "U", "M", "C", "F", "Q" }

local function AddKeybind(tab, id, title, desc, default, action)
    KeyTab[id] = tab
    Ex[id] = default
    Actions[id] = action
    local function set(v)
        local name = typeof(v) == "EnumItem" and v.Name or tostring(v)
        local ok = pcall(function() return Enum.KeyCode[name] end)
        if ok then Ex[id] = name end
        FX.LastKeySet = os.clock() -- para no ejecutar la accion al reasignar una tecla
    end
    local el
    local ok = pcall(function()
        el = tab:Keybind({ Title = title, Desc = desc, Value = default, Callback = set })
    end)
    if ok and el then
        Setters[id] = function(v) pcall(function() el:Set(v) end) end
    else
        local dd = tab:Dropdown({ Title = title, Desc = desc, Values = KEY_CHOICES, Value = default, Callback = set })
        Setters[id] = function(v) pcall(function() dd:Select(v) end) end
    end
end

