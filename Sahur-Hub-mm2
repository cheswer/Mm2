local applied = { speed = false, jump = false }
local orig = { ws = 16, jp = 50, jh = 7.2 }
local flyState = { on = false, bv = nil, bg = nil }

local function stopFly()
    if flyState.bv then pcall(function() flyState.bv:Destroy() end) flyState.bv = nil end
    if flyState.bg then pcall(function() flyState.bg:Destroy() end) flyState.bg = nil end
    local hum = myHum()
    if hum and flyState.on then hum.PlatformStand = false end
    flyState.on = false
end

table.insert(Conns, RunService.Heartbeat:Connect(function()
    local hum = myHum()
    if not hum then return end

    if Ex.SpeedOn then
        if not applied.speed then orig.ws = hum.WalkSpeed; applied.speed = true end
        hum.WalkSpeed = tonumber(Ex.SpeedVal) or 30
    elseif applied.speed then
        hum.WalkSpeed = orig.ws
        applied.speed = false
    end

    if Ex.JumpOn then
        if not applied.jump then orig.jp = hum.JumpPower; orig.jh = hum.JumpHeight; applied.jump = true end
        local v = tonumber(Ex.JumpVal) or 80
        if hum.UseJumpPower then hum.JumpPower = v else hum.JumpHeight = v / 7.2 end
    elseif applied.jump then
        hum.JumpPower = orig.jp
        hum.JumpHeight = orig.jh
        applied.jump = false
    end

    if Ex.Fly then
        local root = myRoot()
        local cam = workspace.CurrentCamera
        if root and cam and hum.Health > 0 then
            if not flyState.bv or not flyState.bv.Parent then
                flyState.bv = mk("BodyVelocity", { Name = "SahurFlyBV", MaxForce = Vector3.new(1e8, 1e8, 1e8), Velocity = Vector3.zero }, root)
            end
            if not flyState.bg or not flyState.bg.Parent then
                flyState.bg = mk("BodyGyro", { Name = "SahurFlyBG", MaxTorque = Vector3.new(1e8, 1e8, 1e8), P = 9e4, CFrame = cam.CFrame }, root)
            end
            hum.PlatformStand = true
            flyState.on = true
            local speed = tonumber(Ex.FlySpeed) or 50
            local md = hum.MoveDirection
            local vel = Vector3.zero
            if md.Magnitude > 0.05 then
                local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
                local flat = Vector3.new(look.X, 0, look.Z)
                local flatR = Vector3.new(right.X, 0, right.Z)
                local f = flat.Magnitude > 0.01 and md:Dot(flat.Unit) or 0
                local s = flatR.Magnitude > 0.01 and md:Dot(flatR.Unit) or 0
                vel = (look * f + right * s) * speed
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, speed, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                vel = vel - Vector3.new(0, speed, 0)
            end
            flyState.bv.Velocity = vel
            flyState.bg.CFrame = cam.CFrame
        end
    elseif flyState.on or flyState.bv or flyState.bg then
        stopFly()
    end
end))

