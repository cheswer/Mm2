local function SerializeEx()
    local out = {}
    for id in pairs(Setters) do
        local v = Ex[id]
        local t = typeof(v)
        if t == "boolean" or t == "number" or t == "string" then
            out[id] = v
        elseif t == "Color3" then
            out[id] = { __c = { v.R, v.G, v.B } }
        end
    end
    return out
end

local function ApplyEx(data, scope)
    if type(data) ~= "table" then return end
    for id, v in pairs(data) do
        local setter = Setters[id]
        if setter and (not scope or scope[GroupOf(id)]) then
            if type(v) == "table" and type(v.__c) == "table" and #v.__c == 3 then
                v = Color3.new(v.__c[1], v.__c[2], v.__c[3])
            end
            if typeof(v) == typeof(Ex[id]) then
                Ex[id] = v
                pcall(setter, v)
            end
        end
