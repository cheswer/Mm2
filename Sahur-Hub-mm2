local last = {}
local function Edge(key, on, onStart, onStop)
    if on and not last[key] then
        last[key] = true
        if onStart then pcall(onStart) end
    elseif not on and last[key] then
        last[key] = false
        if onStop then pcall(onStop) end
    end
end

local flyBV, flyBG
local function StopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    local h = Hum(LocalPlayer)
    if h then h.PlatformStand = false end
end

local origGravity = Workspace.Gravity
local origFOV = nil
local lastSafe, lastSafeT = nil, 0

Cn(RunService.Heartbeat, function(dt)
    local h = Hum(LocalPlayer)
    local r = Root(LocalPlayer)

    -- WalkSpeed / JumpPower
    Edge("ws", Ex.WS_On and h ~= nil, nil, function() if h then h.WalkSpeed = 16 end end)
    if Ex.WS_On and h then h.WalkSpeed = Ex.WS_Val or 16 end
    Edge("jp", Ex.JP_On and h ~= nil, nil, function() if h then h.JumpPower = 50 end end)
    if Ex.JP_On and h then
        h.UseJumpPower = true
        h.JumpPower = Ex.JP_Val or 50
    end

    -- Fly
    local flyOn = Ex.Fly and h ~= nil and r ~= nil and h.Health > 0
    Edge("fly", flyOn, function()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = r
        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyBG.P = 9e4
        flyBG.Parent = r
        h.PlatformStand = true
    end, StopFly)
    if flyOn and flyBV and flyBV.Parent then
        local cam = Camera()
        local sp = Ex.Fly_Speed or 50
        local dir = h.MoveDirection
        local vel = dir * sp
        local up = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or h.Jump then up = up + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then up = up - 1 end
        if cam and dir.Magnitude > 0.1 then
            local look = cam.CFrame.LookVector
            vel = vel + Vector3.new(0, look.Y * sp * dir.Magnitude, 0)
        end
        flyBV.Velocity = vel + Vector3.new(0, up * sp, 0)
        if cam then flyBG.CFrame = cam.CFrame end
    end

    -- Spin
    if Ex.Spin and r and not flyOn then
        r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(Ex.Spin_Speed or 20), 0)
    end

    -- Gravedad
    Edge("grav", Ex.Grav_On, function() origGravity = Workspace.Gravity end, function() Workspace.Gravity = origGravity end)
    if Ex.Grav_On then Workspace.Gravity = Ex.Grav_Val or 100 end

    -- Anti-void
    if Ex.AntiVoid and r then
        if os.clock() - lastSafeT > 0.5 and h and h.FloorMaterial ~= Enum.Material.Air and r.Position.Y > Workspace.FallenPartsDestroyHeight + 150 then
            lastSafe = r.CFrame
            lastSafeT = os.clock()
        end
        if lastSafe and r.Position.Y < Workspace.FallenPartsDestroyHeight + 80 then
            r.AssemblyLinearVelocity = Vector3.zero
            r.CFrame = lastSafe + Vector3.new(0, 4, 0)
        end
    end
end)

