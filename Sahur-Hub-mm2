            if mroot and root and not (md and md.Dead) then
                local d = (mroot.Position - root.Position).Magnitude
                if d <= (tonumber(Ex.ProxDist) or 35) and os.clock() - lastProx > 4 then
                    lastProx = os.clock()
                    Say(string.format(Msg("Murderer nearby: %d studs", "Asesino cerca: %d studs", "Убийца рядом: %d стадов"), math.floor(d + 0.5)), 3)
                end
            end
        end
        task.wait(0.3)
    end
end)

