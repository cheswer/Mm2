function H.Root(char)
    char = char or LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart") or nil
end

function H.Hum(char)
    char = char or LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid") or nil
end

function H.IsAlive(plr)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if plr:GetAttribute("Alive") == false then return false end
    return true
end

function H.Targets()
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and H.IsAlive(p) and H.Root(p.Character) then out[#out + 1] = p end
    end
    return out
end

function H.Nearest(list)
    local root = H.Root()
    if not root then return nil end
    local best, bd = nil, math.huge
    for _, p in ipairs(list or H.Targets()) do
        local r = H.Root(p.Character)
        if r then
            local d = (r.Position - root.Position).Magnitude
            if d < bd then best, bd = p, d end
        end
    end
    return best, bd
end

-- Finds the knife / gun tool in the character or the backpack
function H.GetTool(kind)
    local tag = kind == "Knife" and "Weapon_Knife" or "Weapon_Gun"
    local conts = {}
    if LocalPlayer.Character then conts[#conts + 1] = LocalPlayer.Character end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then conts[#conts + 1] = bp end
    for _, cont in ipairs(conts) do
        for _, t in ipairs(cont:GetChildren()) do
            if t:IsA("Tool") and (t:HasTag(tag) or t.Name == kind) then return t end
        end
    end
    return nil
end

function H.Holding(kind)
    local tool = H.GetTool(kind)
    return tool ~= nil and tool.Parent == LocalPlayer.Character, tool
end

function H.MyRole()
    if H.GetTool("Knife") then return "Murderer" end
    if H.GetTool("Gun") then return "Sheriff" end
    return RS.Role
end

-- Known murderer / sheriff (revealed by their weapon or by role data)
function H.RolePlayer(role)
    for uid, r in pairs(RS.Seen) do
        if r == role then
            local p = Players:GetPlayerByUserId(uid)
            if p and p ~= LocalPlayer and H.IsAlive(p) then return p end
        end
    end
    return nil
end

