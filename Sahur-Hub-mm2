local function BagCount()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local bag = pg and pg:FindFirstChild("CashBag", true)
    if bag then
        for _, d in ipairs(bag:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" then
                local n = tonumber(d.Text:match("%d+"))
                if n then return n end
            end
        end
    end
    return nil
end

task.spawn(function()
    while alive do
        task.wait(0.1)
        if Ex.Farm then
            local r = Root(LocalPlayer)
            local cc = GetCoinContainer()
            if r and cc and IsAlive(LocalPlayer) then
                local bag = BagCount() or collected
                if Ex.Farm_Reset and bag >= (Ex.Bag_Max or 40) then
                    collected = 0
                    local h = Hum(LocalPlayer)
                    if h then h.Health = 0 end
                    task.wait(6)
                else
                    local avoid
                    if Ex.Farm_Avoid then
                        local m = FindByRole("Murderer")
                        if m and m ~= LocalPlayer then avoid = Root(m) end
                    end
                    local best, bd = nil, math.huge
                    for _, c in ipairs(cc:GetChildren()) do
                        if c:IsA("BasePart") and (not Skipped[c] or os.clock() - Skipped[c] > 4) then
                            local d = Dist(r, c)
                            local bad = avoid and (avoid.Position - c.Position).Magnitude < 25
                            if not bad and d < bd then best, bd = c, d end
                        end
                    end
                    if best then
                        local speed = Ex.Farm_Speed or 24
                        local tw = TweenService:Create(r, TweenInfo.new(math.max(bd / speed, 0.05), Enum.EasingStyle.Linear), { CFrame = best.CFrame })
                        tw:Play()
                        local t0 = os.clock()
                        while alive and Ex.Farm and best.Parent and tw.PlaybackState == Enum.PlaybackState.Playing and os.clock() - t0 < 20 do
                            task.wait()
                        end
                        pcall(function() tw:Cancel() end)
                        task.wait(0.12)
                        if best.Parent and best.Transparency < 1 then
                            Skipped[best] = os.clock()
                        else
                            collected = collected + 1
                        end
                    else
                        task.wait(0.5)
                    end
                end
            end
        end
    end
end)

