local roleRF, roleFails = nil, 0

local function needRoles()
    return Ex.ESP_Murderer or Ex.ESP_Sheriff or Ex.ESP_Hero or Ex.ESP_Innocent or Ex.Notify_Reveal
        or Ex.Notify_Gun or Ex.Alert_Prox or Ex.AutoGrab or Ex.Info_Roles
end

local function pollRoles()
    if not roleRF or not roleRF.Parent then
        roleRF = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    end
    if not roleRF or not roleRF:IsA("RemoteFunction") then
        roleFails = roleFails + 1
        if roleFails == 5 then warn("[SAHUR] GetPlayerData no encontrado, se usa deteccion por armas visibles") end
        return
    end
    local ok, data = pcall(function() return roleRF:InvokeServer() end)
    if not ok or type(data) ~= "table" then return end
    RS.RolesOK = true
    local roles, mur, sher, hero = {}, nil, nil, nil
    for name, info in pairs(data) do
        if type(info) == "table" then
            local role = info.Role
            roles[name] = { Role = role, Dead = (info.Killed or info.Dead) and true or false }
            if role == "Murderer" then mur = name
            elseif role == "Sheriff" then sher = name
            elseif role == "Hero" then hero = name end
        end
    end

    if mur and not prevState.revealed then
        prevState.revealed = true
        if Ex.Notify_Reveal then
            Say(Msg("Roles revealed - Murderer: ", "Roles revelados - Asesino: ", "Роли раскрыты - Убийца: ") .. mur
                .. " | " .. Msg("Sheriff: ", "Sheriff: ", "Шериф: ") .. tostring(sher or "-"), 6)
        end
    elseif not mur and prevState.revealed then
        prevState.revealed, prevState.sheriffDead, prevState.heroName = false, false, nil
    end
    if sher and roles[sher] then
        local dead = roles[sher].Dead
        if dead and not prevState.sheriffDead then
            prevState.sheriffDead = true
            if Ex.Notify_Gun then
                Say(Msg("The Sheriff died - the gun can be picked up", "El Sheriff murió - se puede recoger el arma", "Шериф погиб - можно подобрать пистолет"), 5)
            end
        elseif not dead then
            prevState.sheriffDead = false
        end
    end
    if hero and hero ~= prevState.heroName then
        prevState.heroName = hero
        if Ex.Notify_Gun then
            Say(hero .. Msg(" picked up the gun (Hero)", " recogió el arma (Héroe)", " подобрал пистолет (Герой)"), 5)
        end
    end
    RS.Roles, RS.Murderer, RS.Sheriff, RS.Hero = roles, mur, sher, hero
end

task.spawn(function()
    while alive do
        if needRoles() then pcall(pollRoles) end
        task.wait(0.5)
    end
end)

