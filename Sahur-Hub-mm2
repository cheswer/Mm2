    if Cache.cc and Cache.cc.Parent then return Cache.cc end
    Cache.cc = nil
    for _, m in ipairs(Workspace:GetChildren()) do
        if m:IsA("Model") or m:IsA("Folder") then
            local cc = m:FindFirstChild("CoinContainer")
            if cc then Cache.cc = cc return cc end
        end
    end
    return nil
end

local function GetMap()
    local cc = GetCoinContainer()
    return cc and cc.Parent or nil
