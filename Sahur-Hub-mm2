local lagDisabled, lagConn, lagQuality, lagShadows = {}, nil, nil, nil
local function lagKill(inst)
    if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
        if inst.Enabled then
            lagDisabled[inst] = true
            inst.Enabled = false
        end
    end
end
local function lagOn()
    pcall(function()
        lagQuality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    lagShadows = Lighting.GlobalShadows
    Lighting.GlobalShadows = false
    for _, d in ipairs(workspace:GetDescendants()) do pcall(lagKill, d) end
    lagConn = workspace.DescendantAdded:Connect(function(d) pcall(lagKill, d) end)
end
local function lagOff()
    if lagConn then lagConn:Disconnect() lagConn = nil end
    for inst in pairs(lagDisabled) do
        pcall(function() inst.Enabled = true end)
        lagDisabled[inst] = nil
    end
    if lagQuality then pcall(function() settings().Rendering.QualityLevel = lagQuality end) lagQuality = nil end
    if lagShadows ~= nil then Lighting.GlobalShadows = lagShadows lagShadows = nil end
end

local function restoreLighting()
    if lightOrig then
        if fbApplied then
            Lighting.Brightness = lightOrig.Brightness
            Lighting.ClockTime = lightOrig.ClockTime
            Lighting.GlobalShadows = lightOrig.GlobalShadows
            Lighting.Ambient = lightOrig.Ambient
            Lighting.OutdoorAmbient = lightOrig.OutdoorAmbient
        end
        if fogApplied then
            Lighting.FogEnd = lightOrig.FogEnd
            Lighting.FogStart = lightOrig.FogStart
            for a, dens in pairs(atmoOrig) do pcall(function() a.Density = dens end) end
        end
    end
    fbApplied, fogApplied = false, false
end

task.spawn(function()
    local lagActive = false
    while alive do
        pcall(function()
            if Ex.Fullbright then
                saveLighting()
                Lighting.Brightness = tonumber(Ex.FBLevel) or 2
                Lighting.ClockTime = 14
                Lighting.GlobalShadows = false
                Lighting.Ambient = Color3.fromRGB(170, 170, 170)
                Lighting.OutdoorAmbient = Color3.fromRGB(170, 170, 170)
                fbApplied = true
            elseif fbApplied then
                Lighting.Brightness = lightOrig.Brightness
                Lighting.ClockTime = lightOrig.ClockTime
                Lighting.GlobalShadows = lightOrig.GlobalShadows
                Lighting.Ambient = lightOrig.Ambient
                Lighting.OutdoorAmbient = lightOrig.OutdoorAmbient
                fbApplied = false
            end

            if Ex.NoFog then
                saveLighting()
                Lighting.FogEnd = 1e6
                Lighting.FogStart = 1e6
                for _, a in ipairs(Lighting:GetChildren()) do
                    if a:IsA("Atmosphere") then
                        if atmoOrig[a] == nil then atmoOrig[a] = a.Density end
                        a.Density = 0
                    end
                end
                fogApplied = true
            elseif fogApplied then
                Lighting.FogEnd = lightOrig.FogEnd
                Lighting.FogStart = lightOrig.FogStart
                for a, dens in pairs(atmoOrig) do pcall(function() a.Density = dens end) end
                fogApplied = false
            end

            if Ex.Xray then
                local cont = getContainer()
                local map = cont and cont.Parent
                local v = (tonumber(Ex.XrayVal) or 60) / 100
                if map and (map ~= xrayMap or v ~= xrayVal) then
                    restoreXray()
                    xrayMap, xrayVal = map, v
                    for _, p in ipairs(map:GetDescendants()) do
                        if p:IsA("BasePart") and p.Name ~= "Coin_Server" and not p:IsDescendantOf(cont) then
                            p.LocalTransparencyModifier = v
                            xrayParts[p] = true
                        end
                    end
                end
            elseif next(xrayParts) then
                restoreXray()
            end

            if Ex.AntiLag and not lagActive then lagActive = true lagOn()
            elseif not Ex.AntiLag and lagActive then lagActive = false lagOff() end
        end)
        task.wait(0.5)
    end
end)

