-- Intenta saber que arma tiene un jugador (si el juego expone el nombre/ID en la tool)
local function WeaponInfo(p, role)
    local tool = FindTool(p, role == "Murderer" and "Knife" or "Gun")
    if not tool then return nil end
    local nm = tool:GetAttribute("ItemName") or tool:GetAttribute("DisplayName")
    local idv = tool:GetAttribute("ItemID") or tool:GetAttribute("ItemId")
    if not nm then
        local sv = tool:FindFirstChild("ItemName")
        if sv and sv:IsA("StringValue") then nm = sv.Value end
    end
    for _, it in ipairs(DB) do
        if (nm and it.name == nm) or (idv and it.id == tostring(idv)) then return it end
    end
    return nil
end

