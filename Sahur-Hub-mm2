local function playerKind(plr)
    local role, dead = roleOfPlayer(plr)
    if dead then return nil end
    local live = RS.Murderer or next(RS.Seen)
    if role == "Murderer" and Ex.ESP_Murderer then return "Murderer" end
    if role == "Sheriff" and Ex.ESP_Sheriff then return "Sheriff" end
    if role == "Hero" and Ex.ESP_Hero then return "Hero" end
    if role == "Innocent" and Ex.ESP_Innocent and live then return "Innocent" end
    if role == nil and Ex.ESP_Innocent and live and not RS.RolesOK then return "Innocent" end
    if Ex.ESP_Target and RS.Target and plr.Name == RS.Target then return "Target" end
    return nil
end

local function applyPlayerESP(o, plr, kind, hum, root, dist, idx, chams, tag, cam)
    local color = kindColor(kind, idx)
    local fill = (tonumber(Ex.ESP_Fill) or 70) / 100
    if Ex.ESP_Fade then fill = math.clamp(fill + dist / 400, 0, 0.95) end
    o.hl.Enabled = chams
    o.hl.FillColor = color
    o.hl.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.35)
    o.hl.FillTransparency = fill

    o.boxG.Enabled = Ex.ESP_Box and true or false
    o.boxS.Color = color

    local showHB = Ex.ESP_Health and true or false
    o.hbG.Enabled = showHB
    if showHB then
        local r = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        o.hbFill.Size = UDim2.fromScale(1, r)
        o.hbFill.BackgroundColor3 = Color3.fromHSV(r * 0.33, 0.85, 1)
    end

    o.tagG.Enabled = tag
    if tag then
        o.pillS.Color = color
        o.l1.TextColor3 = color
        o.l1.Text = roleLabel(kind)
        local parts = {}
        if Ex.ESP_Names then parts[#parts + 1] = plr.DisplayName end
        if Ex.ESP_Dist then parts[#parts + 1] = string.format("[%dm]", math.floor(dist + 0.5)) end
        local line2 = table.concat(parts, "  ")
        o.l2.Text = line2
        o.l2.Visible = line2 ~= ""
        o.tagG.Size = UDim2.fromOffset(190, line2 ~= "" and 40 or 24)
    end

    local origin = Ex.Tracer_Origin or "Character"
    local thick = tonumber(Ex.Tracer_Thick) or 2
    local use3D = Ex.ESP_Tracers and (origin == "Character" or not HasDrawing)
    if use3D then
        local myR = myRoot()
        local len = myR and (root.Position - myR.Position).Magnitude or 0
        if myR and len > 0.5 then
            if not o.adorn or not o.adorn.Parent then
                o.adorn = mk("LineHandleAdornment", { AlwaysOnTop = true, ZIndex = 3, Transparency = 0.1 }, ESPFolder)
            end
            o.adorn.Adornee = myR
            o.adorn.CFrame = myR.CFrame:ToObjectSpace(CFrame.lookAt(myR.Position, root.Position))
            o.adorn.Length = len
            o.adorn.Thickness = thick
            o.adorn.Color3 = color
            o.adorn.Visible = true
        elseif o.adorn then
            o.adorn.Visible = false
        end
    elseif o.adorn then
        o.adorn.Visible = false
    end
    if Ex.ESP_Tracers and HasDrawing and cam and origin ~= "Character" then
        if not o.line then
            o.line = Drawing.new("Line")
            o.line.Transparency = 1
        end
        local v, onScreen = cam:WorldToViewportPoint(root.Position)
        o.line.Visible = onScreen
        if onScreen then
            local vp = cam.ViewportSize
            local from
            if origin == "Center" then from = Vector2.new(vp.X / 2, vp.Y / 2)
            elseif origin == "Top" then from = Vector2.new(vp.X / 2, 0)
            elseif origin == "Mouse" then from = UserInputService:GetMouseLocation()
            else from = Vector2.new(vp.X / 2, vp.Y) end
            o.line.From = from
            o.line.To = Vector2.new(v.X, v.Y)
            o.line.Color = color
            o.line.Thickness = thick
        end
    elseif o.line then
        o.line.Visible = false
    end
end

local function updatePlayers()
    local anyKind = Ex.ESP_Murderer or Ex.ESP_Sheriff or Ex.ESP_Hero or Ex.ESP_Innocent or Ex.ESP_Target
    if not anyKind then
        for plr in pairs(ESPObjs) do clearESP(plr) end
        return
    end
    local cam = workspace.CurrentCamera
    local root0 = myRoot()
    local anyStyle = Ex.ESP_Chams or Ex.ESP_Box or Ex.ESP_Tag or Ex.ESP_Health or Ex.ESP_Tracers
    local chams = (Ex.ESP_Chams or not anyStyle) and true or false
    local tag = (Ex.ESP_Tag or not anyStyle) and true or false
    local maxD = tonumber(Ex.ESP_MaxDist) or 0
    local idx = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        idx = idx + 1
        if plr ~= LocalPlayer then
            local kind = playerKind(plr)
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local show = kind ~= nil and root ~= nil and hum ~= nil and hum.Health > 0
            local dist = 0
            if show and root0 then
                dist = (root.Position - root0.Position).Magnitude
                if maxD > 0 and dist > maxD then show = false end
            end
            if show then
                local o = ESPObjs[plr]
                if not o or o.char ~= char or not o.hl.Parent then
                    clearESP(plr)
                    o = newPlayerESP(char)
                    ESPObjs[plr] = o
                end
                if o then applyPlayerESP(o, plr, kind, hum, root, dist, idx, chams, tag, cam) end
            else
                clearESP(plr)
            end
        end
    end
    for plr in pairs(ESPObjs) do
        if not plr.Parent then clearESP(plr) end
    end
end

