local function hasGun()
    local function chk(cont)
        if cont then
            for _, t in ipairs(cont:GetChildren()) do
                if t:IsA("Tool") and t:HasTag("Weapon_Gun") then return true end
            end
        end
        return false
    end
    return chk(LocalPlayer.Character) or chk(LocalPlayer:FindFirstChildOfClass("Backpack"))
end

local function grabGun(manual)
    local part = gunPart()
    local root = myRoot()
    if not part then
        if manual then Say(Msg("There is no gun on the ground", "No hay arma en el suelo", "На земле нет пистолета")) end
        return false
    end
    if not root then return false end
    if localRole() == "Murderer" then
        if manual then Say(Msg("The Murderer cannot pick up the gun", "El Asesino no puede recoger el arma", "Убийца не может подобрать пистолет")) end
        return false
    end
    local back = root.CFrame
    local got = false
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, part, 0)
            task.wait(0.05)
            firetouchinterest(root, part, 1)
        end)
        task.wait(0.15)
        got = hasGun()
    end
    if not got then
        root.CFrame = part.CFrame + Vector3.new(0, 1.5, 0)
        local t0 = os.clock()
        while os.clock() - t0 < 0.7 and not hasGun() do task.wait(0.05) end
        root.CFrame = back
        got = hasGun()
    end
    if manual or got then
        Say(got and Msg("Gun picked up", "Arma recogida", "Пистолет подобран")
            or Msg("Could not pick up the gun", "No se pudo recoger el arma", "Не удалось подобрать пистолет"))
    end
    return got
end
GrabGun = function() task.spawn(grabGun, true) end

local lastGrab = 0
task.spawn(function()
    while alive do
        if Ex.AutoGrab and gunPart() and os.clock() - lastGrab > 3 and not hasGun() and localRole() ~= "Murderer" then
            local ok = true
