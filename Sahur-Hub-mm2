local noclipSaved, noclipOn = {}, false
local Farm = { active = false, blacklist = {}, collected = 0, idleSince = nil, status = "-", lastContainer = nil }
local function applyNoclip(on)
    local char = LocalPlayer.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            if on then
                if noclipSaved[p] == nil then noclipSaved[p] = p.CanCollide end
                p.CanCollide = false
            elseif noclipSaved[p] ~= nil then
                p.CanCollide = noclipSaved[p]
                noclipSaved[p] = nil
            end
        end
    end
end
