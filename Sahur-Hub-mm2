local function setHold(on)
    local root = myRoot()
    if not root then return end
    local bv = root:FindFirstChild("SahurHold")
    if on and not bv then
        mk("BodyVelocity", { Name = "SahurHold", MaxForce = Vector3.new(1e8, 1e8, 1e8), Velocity = Vector3.zero }, root)
    elseif not on and bv then
        bv:Destroy()
    end
end

local function nextCoin(root)
    local best, bestD
    local now = os.clock()
    for _, p in ipairs(listCoins()) do
        local bl = Farm.blacklist[p]
        if p.Parent and not (bl and now - bl < 45) then
            local d = (p.Position - root.Position).Magnitude
            if not bestD or d < bestD then best, bestD = p, d end
        end
    end
    return best, bestD
end

task.spawn(function()
    while alive do
        if Ex.AutoFarm then
            local root, hum = myRoot(), myHum()
            if root and hum and hum.Health > 0 then
                local cont = getContainer()
                if cont ~= Farm.lastContainer then
                    Farm.lastContainer = cont
                    Farm.blacklist = {}
                    Farm.idleSince = nil
                end
                Farm.active = true
                setHold(true)
                local coin, d = nextCoin(root)
                if coin then
                    Farm.idleSince = nil
                    Farm.status = Msg("Collecting coins", "Recogiendo monedas", "Сбор монет")
                    local target = coin.CFrame * CFrame.new(0, tonumber(Ex.FarmY) or 0, 0)
                    if Ex.FarmMode == "Teleport" then
                        root.CFrame = target
                        task.wait((tonumber(Ex.FarmDelay) or 20) / 100)
                    else
                        local speed = math.max(tonumber(Ex.FarmSpeed) or 26, 5)
                        local dur = d / speed
                        local tw = TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = target })
                        tw:Play()
                        local t0 = os.clock()
                        while alive and Ex.AutoFarm and coin.Parent and os.clock() - t0 < dur + 0.5 do task.wait(0.03) end
                        pcall(function() tw:Cancel() end)
                        task.wait(0.12)
                    end
                    Farm.blacklist[coin] = os.clock()
                    Farm.collected = Farm.collected + 1
                else
                    Farm.status = Msg("Waiting for coins", "Esperando monedas", "Ожидание монет")
                    Farm.idleSince = Farm.idleSince or os.clock()
                    if Ex.FarmReset and cont and os.clock() - Farm.idleSince > 4 then
                        hum.Health = 0
                        Farm.idleSince = nil
                    end
                    task.wait(0.4)
                end
            else
                task.wait(0.5)
            end
        else
            if Farm.active then
                Farm.active = false
                Farm.status = "-"
                setHold(false)
            end
            task.wait(0.3)
        end
    end
end)

