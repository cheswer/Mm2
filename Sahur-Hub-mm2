-- ICON LOADER
-- El ID suele ser un DECAL. assetdelivery devuelve XML para decals (no un PNG),
-- asi que se resuelve el ID real de la imagen y se valida que sea un PNG de verdad.
----------------------------------------------------
local ICON_ID = 96933717122317
local ICON_FILE = "SahurHub_Icon.png"
local FALLBACK_ICON = "shield" -- icono lucide, siempre funciona

local function IsPng(data)
    return type(data) == "string" and #data > 8 and data:sub(2, 4) == "PNG"
end

-- Descarga con HttpGet y, si el ejecutor lo bloquea, con request
local function Download(url)
    local ok, data = pcall(function() return game:HttpGet(url) end)
    if ok and type(data) == "string" and #data > 0 then return data end
    local f = (syn and syn.request) or request or http_request or (http and http.request) or (fluxus and fluxus.request)
    if f then
        local ok2, res = pcall(f, { Url = url, Method = "GET" })
        if ok2 and type(res) == "table" and type(res.Body) == "string" and #res.Body > 0 then return res.Body end
    end
    return nil
end

local function ResolveImageId(id)
    -- Si es un Decal, saca el ID de la textura real
    local ok, result = pcall(function()
        local obj = game:GetObjects("rbxassetid://" .. id)[1]
        if obj then
            local tex = obj.Texture or obj.Image or obj.ColorMapContent
            if tex then
                return tostring(tex):match("id=(%d+)") or tostring(tex):match("(%d+)$")
            end
        end
    end)
    if ok and result then return result end
    return tostring(id)
end

local function CacheIcon(data)
    if not IsPng(data) then return nil end
    pcall(writefile, ICON_FILE, data)
    local ok, asset = pcall(getcustomasset, ICON_FILE)
    if ok and asset then return asset end
    return nil
end

local function GetIconAsset()
    local canFile = isfile and writefile and readfile and getcustomasset

    -- 1) Usar archivo cacheado si es un PNG valido
    if canFile and isfile(ICON_FILE) then
        local ok, data = pcall(readfile, ICON_FILE)
        if ok and IsPng(data) then
            local ok2, asset = pcall(getcustomasset, ICON_FILE)
            if ok2 and asset then return asset end
        elseif delfile then
            pcall(delfile, ICON_FILE) -- archivo corrupto de intentos anteriores
        end
    end

    -- 2) Resolver ID real y descargar
    local imageId = ResolveImageId(ICON_ID)
    print("[SAHUR] Icon id: " .. tostring(ICON_ID) .. " -> imagen " .. tostring(imageId))

    if canFile then
        -- 2a) assetdelivery con el ID real de la imagen (y con el original)
        for _, id in ipairs({ tostring(imageId), tostring(ICON_ID) }) do
            local asset = CacheIcon(Download("https://assetdelivery.roblox.com/v1/asset/?id=" .. id))
            if asset then return asset end
        end
        -- 2b) miniatura del asset (sirve para decals que assetdelivery no entrega como PNG)
        local meta = Download("https://thumbnails.roblox.com/v1/assets?assetIds=" .. ICON_ID .. "&size=420x420&format=Png&isCircular=false")
        if meta then
            local okj, j = pcall(function() return HttpService:JSONDecode(meta) end)
            local url = okj and type(j) == "table" and j.data and j.data[1] and j.data[1].imageUrl
            if url then
                local asset = CacheIcon(Download(url))
                if asset then return asset end
            end
        end
    end

    -- 3) Usar el ID de imagen resuelto directamente
    if imageId and imageId ~= tostring(ICON_ID) then
        return "rbxassetid://" .. imageId
    end

    -- 4) Fallback seguro (icono lucide de WindUI)
    return FALLBACK_ICON
end

local IconAsset = FALLBACK_ICON
pcall(function()
