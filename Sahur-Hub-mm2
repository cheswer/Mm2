    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = CFrame.new(pos) * root.CFrame.Rotation })
    tw:Play()
    local t0 = os.clock()
    while farmOn() and os.clock() - t0 < t + 0.5 and tw.PlaybackState == Enum.PlaybackState.Playing do
        task.wait()
    end
    pcall(function() tw:Cancel() end)
end

local function resetCharacter()
    local old = LocalPlayer.Character
    local hum = H.Hum()
    if hum then hum.Health = 0 end
    local t0 = os.clock()
    while alive and os.clock() - t0 < 12 do
        task.wait(0.3)
        local c = LocalPlayer.Character
        if c and c ~= old and c:FindFirstChild("HumanoidRootPart") then break end
    end
end

local function idle(state)
    FS.state = state
    FS.moving = false
    FX.NoclipForce = false
end

local function farmStep()
    local root, hum = H.Root(), H.Hum()
    if not root or not hum or hum.Health <= 0 then idle("Waiting for character") return end
    if FS.paused and FS.paused == RS.Seen then idle("Coins banked - waiting for next round") return end
    FS.paused = nil
    if not inRound() then idle("Waiting for a round") return end
    local map = H.GetMap()
    if not map then idle("Waiting for the map") return end

    -- new round or new map: forget visited coins
    if FS.roundSeen ~= RS.Seen or FS.map ~= map then
        FS.roundSeen = RS.Seen
        FS.map = map
        FS.visited = setmetatable({}, { __mode = "k" })
        FS.round = 0
    end

    local full = bagFull()
    if full == nil then full = FS.round >= (tonumber(Ex.Farm_Cap) or 40) end
    if full then
        idle("Bag full")
        if Ex.Farm_ResetFull then
            FS.state = "Bag full - resetting"
            FS.paused = RS.Seen
            resetCharacter()
        else
            task.wait(0.5)
        end
        return
    end

    local coin, part = nearestCoin(map, root)
    if not coin then idle("No coins left") task.wait(0.3) return end

    FS.state = "Collecting coins"
    FS.moving = true
    FX.NoclipForce = true
    moveTo(root, part.Position)
    if not farmOn() then return end
    local r2 = H.Root()
    if r2 and part.Parent and type(firetouchinterest) == "function" then
        pcall(firetouchinterest, r2, part, 0)
        pcall(firetouchinterest, r2, part, 1)
    end
    FS.visited[coin] = true
    if coin.Parent then
        FS.round = FS.round + 1
        FS.session = FS.session + 1
    end
    local d = (tonumber(Ex.Farm_Delay) or 80) / 1000
    if d > 0 then task.wait(d) end
end

-- keep velocity at zero while moving so gravity does not drag the character
table.insert(Conns, RunService.Heartbeat:Connect(function()
    if FS.moving and Ex.Farm_Coins then
        local r = H.Root()
        if r then
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end
end))

task.spawn(function()
