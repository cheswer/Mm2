local Events = {}   -- funciones suscritas: fn(kind, player, extra)
local function Emit(kind, p, extra)
    for _, f in ipairs(Events) do pcall(f, kind, p, extra) end
end

task.spawn(function()
    local prevGun = false
    local prevMurd = false
    while alive do
        for _, p in ipairs(Players:GetPlayers()) do
            local new = GetRole(p)
            local old = Roles[p]
            if old ~= new then
                Roles[p] = new
                if old then Emit("role", p, { old = old, new = new }) end
            end
        end
        for p in pairs(Roles) do if not p.Parent then Roles[p] = nil end end

        local gun = GetGunDrop() ~= nil
        if gun and not prevGun then Emit("gundrop") end
        prevGun = gun
        local murd = FindByRole("Murderer") ~= nil
        if murd and not prevMurd then Emit("roundstart") end
        if not murd and prevMurd then Emit("roundend") end
        prevMurd = murd
        task.wait(0.25)
    end
end)

