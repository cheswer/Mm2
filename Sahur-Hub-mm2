-- Camera-relative movement vector from the game's own controls (works with joystick)
local controls
task.spawn(function()
    local ok, c = pcall(function()
        local ps = LocalPlayer:WaitForChild("PlayerScripts", 10)
        local pm = ps and ps:WaitForChild("PlayerModule", 10)
        return pm and require(pm):GetControls()
    end)
    if ok and c then controls = c end
end)

local function flyDir(hum)
    local cam = workspace.CurrentCamera
    if not cam then return Vector3.zero end
    local dir = Vector3.zero
    local mv
    if controls then
        local ok, v = pcall(function() return controls:GetMoveVector() end)
        if ok then mv = v end
    end
    if mv then
        dir = cam.CFrame.RightVector * mv.X + cam.CFrame.LookVector * (-mv.Z)
    else
        local md = hum.MoveDirection
        if md.Magnitude > 0 then
            local look = cam.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            local f = flat.Magnitude > 0 and md:Dot(flat.Unit) or 0
            dir = md + Vector3.new(0, look.Y * math.max(f, 0), 0)
        end
    end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
    if dir.Magnitude > 1 then dir = dir.Unit end
    return dir
end

local function stopFly()
    if st.bv then pcall(function() st.bv:Destroy() end) st.bv = nil end
    local hum = st.flyHum
    if hum and hum.Parent then pcall(function() hum.PlatformStand = false end) end
    st.flyHum = nil
end

table.insert(Conns, RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    -- Speed
    if Ex.Speed then
        local target = tonumber(Ex.SpeedVal) or 32
        if Ex.SpeedMethod == "CFrame" then
            if st.ws then hum.WalkSpeed = st.ws st.ws = nil end
            local md = hum.MoveDirection
            if md.Magnitude > 0 and not Ex.Fly then
                local extra = math.max(target - hum.WalkSpeed, 0)
                root.CFrame = root.CFrame + md * extra * dt
            end
        else
            if not st.ws then st.ws = hum.WalkSpeed end
            hum.WalkSpeed = target
        end
    elseif st.ws then
        hum.WalkSpeed = st.ws
        st.ws = nil
    end

    -- Jump power
    if Ex.JumpOn then
        if not st.jp then st.jp = { hum.UseJumpPower, hum.JumpPower } end
        hum.UseJumpPower = true
        hum.JumpPower = tonumber(Ex.JumpVal) or 50
    elseif st.jp then
        hum.UseJumpPower = st.jp[1]
        hum.JumpPower = st.jp[2]
        st.jp = nil
    end

    -- Fly
    if Ex.Fly then
        if st.bv and st.bv.Parent ~= root then st.bv = nil end
        if not st.bv then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
            bv.Parent = root
            st.bv = bv
        end
        if st.flyHum ~= hum then
            st.flyHum = hum
            hum.PlatformStand = true
        end
        st.bv.Velocity = flyDir(hum) * (tonumber(Ex.FlySpeed) or 50)
    elseif st.bv then
        stopFly()
    end

    -- Anti void
    if Ex.AntiVoid then
        local limit = workspace.FallenPartsDestroyHeight + 60
        if root.Position.Y < limit and st.safe then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = st.safe + Vector3.new(0, 6, 0)
        elseif hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > limit + 40 then
            st.safe = root.CFrame
        end
    end
end))

