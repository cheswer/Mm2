local lastProx = 0
task.spawn(function()
    while alive do
        if Ex.Alert_Prox and RS.Murderer and localRole() ~= "Murderer" then
            local md = RS.Roles[RS.Murderer]
            local mp = Players:FindFirstChild(RS.Murderer)
            local mroot = mp and mp.Character and mp.Character:FindFirstChild("HumanoidRootPart")
