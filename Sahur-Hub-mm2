end

local GunESP
local function UpdateESP()
    local me = Root(LocalPlayer)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local role = Roles[p] or "Innocent"
            local char = Char(p)
            local show = Ex.ESP and char and role ~= "Dead"
                and (role ~= "Innocent" or Ex.ESP_Inno ~= false)
            if not show then
                ClearESP(p)
            else
                local e = ESP[p]
                if e and (e.char ~= char or not e.hl.Parent) then ClearESP(p) e = nil end
                if not e then e = MakeESP(p, char) end
                local col = RoleColor(role)
                e.hl.FillColor = col
                e.hl.OutlineColor = col
                e.hl.Enabled = Ex.ESP_Chams ~= false
                e.gui.Enabled = (Ex.ESP_Name ~= false) or (Ex.ESP_Dist ~= false) or (Ex.ESP_HP == true)
                e.lbl.TextColor3 = col
                local parts = {}
                if Ex.ESP_Name ~= false then
                    parts[#parts + 1] = p.DisplayName .. (role ~= "Innocent" and (" [" .. role .. "]") or "")
                end
                if Ex.ESP_Weapon then
                    local it = WeaponInfo(p, role)
                    if it then
                        parts[#parts + 1] = it.name .. " (" .. it.rarity .. (it.chroma and ", Chroma" or "") .. ")"
                    end
                end
                local h = Hum(p)
                local bits = {}
                if Ex.ESP_HP and h then bits[#bits + 1] = math.floor(h.Health) .. " HP" end
                local r = Root(p)
                if Ex.ESP_Dist ~= false and me and r then bits[#bits + 1] = math.floor(Dist(me, r)) .. "m" end
                if #bits > 0 then parts[#parts + 1] = table.concat(bits, " | ") end
                e.lbl.Text = table.concat(parts, "\n")
                e.root = r
                e.col = col
            end
        end
    end
    for p in pairs(ESP) do
        if not p.Parent then ClearESP(p) end
    end

    -- Arma caida
    local gd = GetGunDrop()
    if Ex.ESP_Gun and gd then
        if not GunESP or not GunESP.hl.Parent or GunESP.target ~= gd then
            if GunESP then pcall(function() GunESP.hl:Destroy() end) pcall(function() GunESP.gui:Destroy() end) end
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(255, 220, 60)
            hl.OutlineColor = Color3.fromRGB(255, 220, 60)
            hl.FillTransparency = 0.4
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = gd
            hl.Parent = Gui
            local gui = Instance.new("BillboardGui")
            gui.AlwaysOnTop = true
            gui.Size = UDim2.fromOffset(120, 24)
            gui.StudsOffset = Vector3.new(0, 2, 0)
            gui.Adornee = gd:IsA("BasePart") and gd or (gd:IsA("Model") and gd.PrimaryPart) or nil
            gui.Parent = Gui
            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Size = UDim2.fromScale(1, 1)
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 14
            lbl.TextColor3 = Color3.fromRGB(255, 220, 60)
            lbl.TextStrokeTransparency = 0.3
            lbl.Text = "GUN"
            lbl.Parent = gui
            GunESP = { hl = hl, gui = gui, target = gd }
        end
    elseif GunESP then
        pcall(function() GunESP.hl:Destroy() end)
        pcall(function() GunESP.gui:Destroy() end)
        GunESP = nil
    end
end

task.spawn(function()
