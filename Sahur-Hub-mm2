-- Teletransportes
----------------------------------------------------
local function tpCF(cf)
    local root = myRoot()
    if root then root.CFrame = cf return true end
    return false
end

local function tpToPlayer(plr)
    local c = plr and plr.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if r then return tpCF(r.CFrame * CFrame.new(0, 0, 3)) end
    return false
end

local function tpLobby()
    local lobby = workspace:FindFirstChild("Lobby")
    local spot = lobby and (lobby:FindFirstChild("Spawns") or lobby)
    local part = spot and spot:FindFirstChildWhichIsA("BasePart", true)
    if not part then part = workspace:FindFirstChildWhichIsA("SpawnLocation", true) end
    if part then
        tpCF(part.CFrame + Vector3.new(0, 4, 0))
    else
        Say(Msg("Lobby not found", "No se encontró el lobby", "Лобби не найдено"))
    end
end

local function tpMap()
    local coins = listCoins()
    local root = myRoot()
    if coins[1] and root then
        local best, bd
        for _, p in ipairs(coins) do
            local d = (p.Position - root.Position).Magnitude
            if not bd or d < bd then best, bd = p, d end
        end
        tpCF(best.CFrame + Vector3.new(0, 3, 0))
        return
    end
    local cont = getContainer()
    local map = cont and cont.Parent
    if map and map:IsA("Model") then
        tpCF(map:GetPivot() + Vector3.new(0, 12, 0))
    else
        Say(Msg("There is no map loaded", "No hay mapa cargado", "Карта не загружена"))
    end
end

local function tpRole(roleName)
    if not roleName then
        Say(Msg("That role is not known yet", "Ese rol todavía no se conoce", "Эта роль пока неизвестна"))
        return
    end
    local plr = Players:FindFirstChild(roleName)
    if not (plr and tpToPlayer(plr)) then
        Say(Msg("Could not teleport to that player", "No se pudo ir a ese jugador", "Не удалось телепортироваться к игроку"))
    end
end

local function serverHop()
    local okG, body = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    if not okG then
        Say(Msg("Could not fetch the server list", "No se pudo obtener la lista de servidores", "Не удалось получить список серверов"))
        return
    end
    local okJ, data = pcall(function() return HttpService:JSONDecode(body) end)
    if okJ and type(data) == "table" and type(data.data) == "table" then
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers - 1 then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer) end)
                return
            end
        end
    end
    Say(Msg("No other server found", "No se encontró otro servidor", "Другой сервер не найден"))
end

