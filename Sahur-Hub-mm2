-- Deteccion de portadores de arma (tags Weapon_Knife / Weapon_Gun)
local function weaponRole(tool)
    if tool:IsA("Tool") then
        if tool:HasTag("Weapon_Knife") then return "Murderer" end
        if tool:HasTag("Weapon_Gun") then return "Sheriff" end
    end
    return nil
end

local function roleFromContainer(container)
    if not container then return nil end
    for _, c in ipairs(container:GetChildren()) do
        local r = weaponRole(c)
        if r then return r end
    end
    return nil
end

local function scanHolders()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local role = roleFromContainer(plr.Character) or roleFromContainer(plr:FindFirstChildOfClass("Backpack"))
            if role and RS.Seen[plr.UserId] ~= role then
                RS.Seen[plr.UserId] = role
                if Ex.Notify_Holders then
                    if role == "Murderer" then
                        Say(string.format(Msg("%s has the knife: Murderer", "%s tiene el cuchillo: es el Asesino", "%s держит нож: это убийца"), plr.DisplayName), 5)
                    else
                        Say(string.format(Msg("%s has the gun: Sheriff", "%s tiene el arma: es el Sheriff", "%s держит пистолет: это шериф"), plr.DisplayName), 5)
                    end
                end
            end
        end
    end
end

