-- ESP (Highlight + etiqueta)
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "SahurESP"
ESPFolder.Parent = Gui
local ESPObjs = {}

local function clearESP(plr)
    local o = ESPObjs[plr]
    if o then
        pcall(function() o.hl:Destroy() end)
        pcall(function() o.bb:Destroy() end)
        ESPObjs[plr] = nil
    end
end

local function ensureESP(plr, char)
    local o = ESPObjs[plr]
    if o and o.char == char and o.hl.Parent and o.bb.Parent then return o end
    clearESP(plr)
    local hl = Instance.new("Highlight")
    hl.Adornee = char
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.OutlineTransparency = 0
    hl.Parent = ESPFolder
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(180, 34)
    bb.StudsOffset = Vector3.new(0, 3.4, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    bb.Parent = ESPFolder
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextStrokeTransparency = 0
    lbl.Parent = bb
    o = { hl = hl, bb = bb, lbl = lbl, char = char }
    ESPObjs[plr] = o
    return o
end

local function updateESP()
    local anyOn = Ex.ESP_Murderer or Ex.ESP_Sheriff or Ex.ESP_Target or Ex.ESP_Innocent
    if not anyOn then
        for plr in pairs(ESPObjs) do clearESP(plr) end
        return
    end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local color, label
            local role = RS.Seen[plr.UserId]
            if role == "Murderer" and Ex.ESP_Murderer then
                color, label = ROLE_COLORS.Murderer, tRole("Murderer")
            elseif role == "Sheriff" and Ex.ESP_Sheriff then
                color, label = ROLE_COLORS.Sheriff, tRole("Sheriff")
            elseif Ex.ESP_Target and RS.Target and plr.Name == RS.Target then
                color, label = TARGET_COLOR, Msg("Target", "Objetivo", "Цель")
            elseif Ex.ESP_Innocent and role == nil and RS.Active and plr:GetAttribute("Alive") ~= false then
                color, label = ROLE_COLORS.Innocent, tRole("Innocent")
            end
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local show = color ~= nil and root ~= nil
            local dist = 0
            if show and myRoot then
                dist = (root.Position - myRoot.Position).Magnitude
                local maxD = tonumber(Ex.ESP_MaxDist) or 0
                if maxD > 0 and dist > maxD then show = false end
            end
            if show then
                local o = ensureESP(plr, char)
                o.hl.FillColor = color
                o.hl.OutlineColor = color
                o.hl.FillTransparency = (tonumber(Ex.ESP_Fill) or 70) / 100
                local text = label
                if Ex.ESP_Names then text = plr.DisplayName .. " - " .. text end
                if Ex.ESP_Dist then text = text .. string.format(" [%d]", math.floor(dist + 0.5)) end
                o.lbl.Text = text
                o.lbl.TextColor3 = color
            else
                clearESP(plr)
            end
        end
    end
    for plr in pairs(ESPObjs) do
        if not plr.Parent then clearESP(plr) end
    end
end

task.spawn(function()
    while alive do
        pcall(scanHolders)
        pcall(updateESP)
        task.wait(0.25)
    end
end)

